{
  "name": "conclave-design-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vendored design-canvas viewer sidecar: a Vite dev server the Conclave engine spawns and supervises, rendering the .arta/ file contract any agent CLI writes into.",
  "license": "MIT",
  "bin": {
    "conclave-design-viewer": "bin/viewer.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "start": "node bin/viewer.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "modern-screenshot": "^4.7.0",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
